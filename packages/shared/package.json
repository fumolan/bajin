{
  "name": "@bajin/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./platform/shell-options": {
      "types": "./dist/platform/shell-options.d.ts",
      "default": "./dist/platform/shell-options.js"
    },
    "./browser-url": {
      "types": "./dist/browser-url.d.ts",
      "default": "./dist/browser-url.js"
    },
    "./plan-view": {
      "types": "./dist/plan-view.d.ts",
      "default": "./dist/plan-view.js"
    },
    "./tab-ops": {
      "types": "./dist/tab-ops.d.ts",
      "default": "./dist/tab-ops.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
